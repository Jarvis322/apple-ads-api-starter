# Values shown after uploading your public key in Apple Ads > Account Settings > API.
APPLE_ADS_CLIENT_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_ADS_TEAM_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_ADS_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Recommended: keep the private key outside this repository and use an absolute path.
APPLE_ADS_PRIVATE_KEY_PATH=/absolute/path/outside/repository/private-key.pem

# Alternative (for example, a secret manager): provide PEM content on one line using \n.
# APPLE_ADS_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# The orgId returned by Get User ACL (/acls). The /acls call itself does not require it.
APPLE_ADS_ORG_ID=123456789

PORT=3000

# Set to true to preview the dashboard with sample data and no Apple credentials.
APPLE_ADS_MOCK=false
